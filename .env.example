# Shared by every service. The install script generates the secrets.
HOST=127.0.0.1
INDUS_BOT_TOKEN=
INDUS_SSO_SECRET=
INDUS_ENCRYPTION_KEY=
INDUS_SETUP_TOKEN=
INDUS_SHARED_DIR=/opt/indus/shared
HUB_URL=http://127.0.0.1:41731
SCHEDULER_URL=http://127.0.0.1:41748

# ollama on this machine. qwen2.5:3b or llama3.2:3b. Use qwen2.5:1.5b if 3B is too slow.
INDUS_LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_MS=240000

# Set COOKIE_SECURE=0 only for local http.
COOKIE_SECURE=1
WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

MAILFORGE_BASE_URL=http://127.0.0.1:5000
